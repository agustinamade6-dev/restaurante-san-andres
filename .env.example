DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones (mínimo 32 caracteres). OBLIGATORIO en producción.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En desarrollo, si falta, se genera un secreto aleatorio por proceso (con aviso en consola): las sesiones no sobreviven a un reinicio.
# La app de escritorio (Electron) genera y guarda el suyo automáticamente.
SESSION_SECRET=

# Datos del comercio que se imprimen en los tickets (opcionales: si faltan se usan valores de ejemplo).
# En la app de escritorio se editan en config.json, sección "negocio".
# NEGOCIO_NOMBRE=Restaurante San Andrés
# NEGOCIO_CUIT=30-12345678-9
# NEGOCIO_DIRECCION=Av. San Martín 1234, San Andrés
